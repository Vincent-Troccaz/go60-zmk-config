        };

        /* ========================================================= *
         * MOD-MORPHS pour ...                                       *
         * ========================================================= */

        minus_qmark: minus_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "- / ?";
            bindings = <&kp KP_MINUS>, <&kp QMARK>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = ". / :";
            bindings = <&kp KP_DOT>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = ", / ;";
            bindings = <&kp KP_COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        q_or_circ: q_or_circ {
            compatible = "zmk,behavior-mod-morph";
            label = "q / ^";
            bindings = <&kp A>, <&kp LBKT>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        td_accent_layer: td_accent_layer {
            compatible = "zmk,behavior-tap-dance";
            label = "Layer 5/6";
            #binding-cells = <0>;
            bindings = <&sl 5>, <&sl 6>;

            tapping-term-ms = <400>;
        };

        
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_select_0: bt_select_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_select_1: bt_select_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_select_2: bt_select_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_select_3: bt_select_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };

         /* ==========================================
         * MACROS pour R4
         * ========================================== */
        
        // ¦ (broken bar) U+00A6 - Compose : Compose + ! + ^
        broken_bar_compose: broken_bar_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap>, <&kp RCTRL>,         /* Compose */
                <&macro_tap>, <&kp FSLH>,          /* ! en FR */
                <&macro_tap>, <&kp RA(N9)>;        /* ^ en FR */
            label = "¦";
        };

        

        /* ======================================================= *
         * MACROS pour INDICES et EXPOSANTS de 1-2-3-4-5-6-7-8-9-0 *
         * ======================================================= */

        /* Subscripts: Compose + _ + digit => ₁..₅ */
        sub_1: sub_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp N8>, // FR N8 -> _ under
                <&macro_tap &kp KP_N1>;
        };

        sub_2: sub_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp N8>, // FR N8 -> _ under
                <&macro_tap &kp KP_N2>;
        };

        sub_3: sub_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp N8>, // FR N8 -> _ under
                <&macro_tap &kp KP_N3>;
        };

        sub_4: sub_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp N8>, // FR N8 -> _ under
                <&macro_tap &kp KP_N4>;
        };

        sub_5: sub_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp N8>, // FR N8 -> _ under
                <&macro_tap &kp KP_N5>;
        };

        sub_6: sub_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp N8>,               // FR N8 -> _ under
                <&macro_tap &kp KP_N6>;
            label = "₆";
        };
        
        sub_7: sub_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp N8>,
                <&macro_tap &kp KP_N7>;
            label = "₇";
        };
        
        sub_8: sub_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp N8>,
                <&macro_tap &kp KP_N8>;
            label = "₈";
        };
        
        sub_9: sub_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp N8>,
                <&macro_tap &kp KP_N9>;
            label = "₉";
        };
        
        sub_0: sub_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp N8>,
                <&macro_tap &kp KP_N0>;
            label = "₀";
        };

        sup_1: sup_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp RA(N9)>,
                <&macro_tap &kp KP_N1>;
        };

        sup_2: sup_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp RA(N9)>,
                <&macro_tap &kp KP_N2>;
        };

        sup_3: sup_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp RA(N9)>,
                <&macro_tap &kp KP_N3>;
        };

        sup_4: sup_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp RA(N9)>,
                <&macro_tap &kp KP_N4>;
        };

        sup_5: sup_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp RA(N9)>,
                <&macro_tap &kp KP_N5>;
        };

        sup_6: sup_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp RA(N9)>,           // ^ en FR = AltGr+9
                <&macro_tap &kp KP_N6>;
            label = "⁶";
        };
        
        sup_7: sup_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp RA(N9)>,
                <&macro_tap &kp KP_N7>;
            label = "⁷";
        };
        
        sup_8: sup_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp RA(N9)>,
                <&macro_tap &kp KP_N8>;
