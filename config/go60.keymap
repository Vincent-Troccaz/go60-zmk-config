            bindings = <&kp LS(LBKT) &kp Y>;
            label = "ÿ";
            wait-ms = <0>;
        };

        // Tréma : ẗ (¨ + t) - rare

        t_diae: t_diae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp T>;
            label = "ẗ";
