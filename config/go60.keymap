        };
        
        /* =========
         * LH R4 C5 : z / Z / ~ / rien
         * ========= */
        
        lhr4c5: lhr4c5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp W &lhr4c5_shift_altgr>;    // Z en mapping inversé = W
        };
        
        lhr4c5_shift_altgr: lhr4c5_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RA(N2) &none>;             // ~ / rien
        };
        
        /* ==========================================
         * MOD-MORPHS pour RH R4
         * ========================================== */
        
        /* =========
         * RH R4 C1 : . / : / | / ¦
         * ========= */
        
        rhr4c1: rhr4c1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&rhr4c1_no_altgr &rhr4c1_shift_altgr>;
        };
        
        rhr4c1_no_altgr: rhr4c1_no_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LS(COMMA) &kp DOT>;        // . / :
        };
        
        rhr4c1_shift_altgr: rhr4c1_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RA(N6) &broken_bar_compose>;  // | / ¦
        };
        
        /* =========
         * RH R4 C2 : h / H / ! / ¬
         * ========= */
        
        rhr4c2: rhr4c2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
