        layer_Accented {
            bindings = <
&trans  &trans    &trans     &trans     &kp LS(RA(E))     &permille_compose                                                 &none              &none        &kp LS(FSLH)  &pilcrow_compose  &kp LS(MINUS)   &trans
&trans  &kp RA(W) &kp N9     &kp RA(O)  &kp RA(P)         &none                                                             &none              &kp LS(BSLH) &kp N8        &sl 6             &kp RA(SQT)     &trans
&trans  &kp N0    &kp N2     &kp N7     &kp RA(R)         &n_tilde                                                          &kp N5             &kp MINUS    &kp RA(I)     &kp RA(K)         &kp SQT         &trans
&trans  &kp RA(A) &kp RA(S)  &kp N6     &kp LS(RA(N5))    &kp LS(RA(N4))                                                    &kp LS(RA(M))      &none        &sl 7         &kp LS(RA(COMMA)) &none           &trans
                  &trans     &trans     &trans                                                                                                 &trans       &trans        &trans
                                                                             &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Diae_Supplement {
            bindings = <
&trans  &trans   &trans   &trans   &trans  &trans                                                   &trans  &trans   &trans   &trans   &trans   &trans
&trans  &trans   &trans   &o_diae  &trans  &w_diae                                                  &trans  &trans   &trans   &trans   &y_diae  &trans
&trans  &a_diae  &trans   &e_diae  &trans  &trans                                                   &trans  &trans   &t_diae  &i_diae  &u_diae  &trans
&trans  &trans   &x_diae  &trans   &trans  &trans                                                   &trans  &h_diae  &trans   &trans   &trans   &trans
                 &trans   &trans   &trans                                                                   &trans   &trans   &trans
                                                    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Greek_Symbols {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans        &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &omega                                                  &trans  &kp LS(BSLH)  &mu_greek  &trans  &psi    &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans        &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans        &trans     &trans  &trans  &trans
                &trans  &trans  &trans                                                                  &trans        &trans     &trans
                                                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

&cirque_rh_listener {
    input-processors = <&zip_xy_scaler 3 1>;

    layer_2 {
        layers = <2>;
        input-processors = <&zip_xy_scaler 9 1>;
    };
};

&cirque_lh_listener {
    input-processors =
        <&zip_xy_to_scroll_mapper>,
        <&zip_xy_scaler 1 8>,
        <&zip_click_to_right_click_mapper>;

    layer_4 {
        layers = <4>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};
