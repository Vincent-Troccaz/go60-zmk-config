        };
        
        sup_0: sup_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp RA(N9)>,
                <&macro_tap &kp KP_N0>;
            label = "⁰";
        };

        /* ======================================================= *
         * MACROS pour la couche layer_accented                    *
         * ======================================================= */

        /* LH R2 C1 — '‰' via Compose : Compose + % + o */
        permille_compose: permille_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap     &kp RCTRL>,    /* Compose */
                <&macro_press   &kp RSHFT>,    /* % */
                <&macro_tap     &kp SQT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap     &kp O>;        /* o => ‰ */
            label = "‰";
        };

        // Pilcrow : ¶ (Compose + P + !)

        pilcrow_compose: pilcrow_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,
                <&macro_release &kp LSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_tap     &kp RCTRL>,    /* Compose */
                <&macro_tap     &kp P>,        /* P */
                <&macro_tap     &kp FSLH>;     /* ! => ¶ */
            label = "¶";
        };

        // ñ (n tilde) U+00F1
        // N tilde : ñ (~ + n)

        n_tilde: n_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                <&macro_tap &kp RA(LBKT)>,  /* ~  en FR */
                <&macro_tap &kp N>;         /* N => ñ */
            label = "ñ";
        };

        // • (bullet) U+2022
        // Bullet : • (Compose + . + =)

        bullet_compose: bullet_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&kp RCTRL>,            // Compose
                <&kp KP LS(COMMA)>,     // ; en FR
                <&kp KP_EQUAL>;         // =
            label = "•";
        };

        /* =========================================================== *
         * MACROS dont il faut vérifier si elles sont encore utilisées *
         * =========================================================== */

        /* -----------------------------
         *  Compose helpers (RCTRL = Compose)
         * ----------------------------- */

        euro_compose: euro_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp E>,
                <&macro_tap &kp EQUAL>;
        };

        guillemotleft_compose: guillemotleft_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_tap &kp RCTRL>,
                <&macro_tap &kp NON_US_BSLH>,
                <&macro_tap &kp NON_US_BSLH>;
        };

        guillemotright_compose: guillemotright_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_tap &kp RCTRL>,
                <&macro_press &kp RSHFT>,
                <&macro_tap &kp NON_US_BSLH>,
                <&macro_tap &kp NON_US_BSLH>,
                <&macro_release &kp RSHFT>;
        };

        // LH R2 C5
        caret_literal: caret_literal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LBKT &kp SPACE>;
        };

        // LH R2 C4
        // Inférieur ou égal : ≤ (Compose + < + =)
        leq_compose: leq_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,         /* neutralise AltGr */
                <&macro_release &kp LSHFT>,        /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap     &kp RCTRL>,        /* Compose */
                <&macro_tap     &kp NON_US_BSLH>,  /* < sur FR */
                <&macro_tap     &kp EQUAL>;       /* = */
            label = "≤";
        };

        // LH R2 C3 — '>' direct (sans dead-key / sans dépendre des mods tenus)
        gt_literal: gt_literal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_release &kp RALT>,          /* neutralise AltGr */
                <&macro_release &kp LSHFT>,         /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_press   &kp RSHFT>,         /* fabrique '>' = Shift + NON_US_BSLH */
                <&macro_tap     &kp NON_US_BSLH>,
                <&macro_release &kp RSHFT>;
          label = ">";
        };

        // LH R2 C3 — '≥' via Compose : Compose + '>' + '='
        geq_compose: geq_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,          /* neutralise AltGr */
                <&macro_release &kp LSHFT>,         /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_tap     &kp RCTRL>,         /* Compose */
                <&macro_press   &kp RSHFT>,         /* '>' = Shift + NON_US_BSLH */
                <&macro_tap     &kp NON_US_BSLH>,
                <&macro_release &kp RSHFT>,
                <&macro_tap     &kp EQUAL>;
          label = "≥";
        };

        /* LH R2 C1 — '%' (AZERTY FR: Shift + (key right of M) => keycode COMMA) */
        percent_literal: percent_literal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_release &kp RALT>,     /* neutralise AltGr */
                <&macro_release &kp LSHFT>,    /* neutralise Shift */
                <&macro_release &kp RSHFT>,
                <&macro_press   &kp RSHFT>,    /* % = Shift + COMMA (sur OS FR) */
                <&macro_tap     &kp SQT>,
                <&macro_release &kp RSHFT>;
          label = "%";
        };

        

        // Accent circonflexe : â (^ + a)

        a_circ: a_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp Q>;
            label = "â";
        };

        // Accent circonflexe : ê (^ + e)

        e_circ: e_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp E>;
            label = "ê";
        };

        // Accent circonflexe : î (^ + i)

        i_circ: i_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp I>;
            label = "î";
        };

        // Accent circonflexe : ô (^ + o)

        o_circ: o_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp O>;
            label = "ô";
        };

        // Accent circonflexe : û (^ + u)

        u_circ: u_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp U>;
            label = "û";
        };

        // Tréma : ï (¨ + i)

        i_diae: i_diae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp I>;
            label = "ï";
            wait-ms = <0>;
        };

        // Tréma : ü (¨ + u)

        u_diae: u_diae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp U>;
            label = "ü";
            wait-ms = <0>;
        };

        // Tréma : ë (¨ + e)

        e_diae: e_diae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp E>;
            label = "ë";
            wait-ms = <0>;
