            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp COMMA &none>;              // ; / rien
        };
        
        /* =========
         * RH R4 C4 : , / ; / : / rien
         * ========= */
        
        rhr4c4: rhr4c4 {
            compatible = "zmk,behavior-mod-morph";
