#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// layers

#define LAYER_Base 0
#define LAYER_Keypad 1
#define LAYER_SymbolNav 2
#define LAYER_Magic 3
#define LAYER_Factory 4

/ {
    input_processors {
        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };

    behaviors {
        magic: magic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        keypad_td: keypad_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LAYER_Keypad>, <&to LAYER_Keypad>;
        };

        symbol_nav_td: symbol_nav_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LAYER_SymbolNav>, <&to LAYER_SymbolNav>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_0>, <&bt BT_DISC 0>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_1>, <&bt BT_DISC 1>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_2>, <&bt BT_DISC 2>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_3>, <&bt BT_DISC 3>;
        };


        /* ========================================================= *
         * MOD-MORPHS pour LH et RH R1 (touches 1-2-3-4-5-6-7-8-9-0) *
         * ========================================================= */

        /* =========
         * LH R1 C1 : 5 / % / ₅ / ⁵
         * ========= */

        lhr1c1_shift: lhr1c1_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp KP_N5 &kp LS(SQT)>;
        };

        lhr1c1_altgr_shift: lhr1c1_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sub_5 &sup_5>;
        };

        lhr1c1: lhr1c1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&lhr1c1_shift &lhr1c1_altgr_shift>;
        };

        /* =========
         * LH R1 C2 : 4 / $ / ₄ / ⁴
         * ========= */

        lhr1c2_shift: lhr1c2_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp KP_N4 &kp RBKT>;
        };

        lhr1c2_altgr_shift: lhr1c2_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sub_4 &sup_4>;
        };

        lhr1c2: lhr1c2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&lhr1c2_shift &lhr1c2_altgr_shift>;
        };

        /* =========
         * LH R1 C3 : 3 / » / ₃ / ³
         * ========= */

        lhr1c3_shift: lhr1c3_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp KP_N3 &kp RA(X)>;
        };

        lhr1c3_altgr_shift: lhr1c3_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sub_3 &sup_3>;
        };

        lhr1c3: lhr1c3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&lhr1c3_shift &lhr1c3_altgr_shift>;
        };

        /* =========
         * LH R1 C4 : 2 / « / ₂ / ²
         * ========= */

        lhr1c4_shift: lhr1c4_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp KP_N2 &kp RA(Z)>;
        };

        lhr1c4_altgr_shift: lhr1c4_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sub_2 &sup_2>;
        };

        lhr1c4: lhr1c4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&lhr1c4_shift &lhr1c4_altgr_shift>;
        };

        /* =========
         * LH R1 C5 : 1 / € / ₁ / ¹
         * ========= */

        lhr1c5_shift: lhr1c5_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp KP_N1 &kp RA(E)>;
        };

        lhr1c5_altgr_shift: lhr1c5_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sub_1 &sup_1>;
        };

        lhr1c5: lhr1c5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&lhr1c5_shift &lhr1c5_altgr_shift>;
        };

        /* =========
         * RH R1 C1 : 6 / ^ / ₆ / ⁶
         * ========= */
        
        rhr1c1_shift: rhr1c1_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp KP_N6 &kp LBKT>;       // ^ = LBKT en FR
        };
        
        rhr1c1_altgr_shift: rhr1c1_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sub_6 &sup_6>;
        };
        
        rhr1c1: rhr1c1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&rhr1c1_shift &rhr1c1_altgr_shift>;
        };
        
        /* =========
         * RH R1 C2 : 7 / & / ₇ / ⁷
         * ========= */
        
        rhr1c2_shift: rhr1c2_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp KP_N7 &kp N1>;         // & = N1 en FR
        };
        
        rhr1c2_altgr_shift: rhr1c2_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sub_7 &sup_7>;
        };
        
        rhr1c2: rhr1c2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&rhr1c2_shift &rhr1c2_altgr_shift>;
        };
        
        /* =========
         * RH R1 C3 : 8 / * / ₈ / ⁸
         * ========= */
        
        rhr1c3_shift: rhr1c3_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp KP_N8 &kp BSLH>;       // * = BSLH en FR
        };
        
        rhr1c3_altgr_shift: rhr1c3_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sub_8 &sup_8>;
        };
        
        rhr1c3: rhr1c3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&rhr1c3_shift &rhr1c3_altgr_shift>;
        };
        
        /* =========
         * RH R1 C4 : 9 / # / ₉ / ⁹
         * ========= */
        
        rhr1c4_shift: rhr1c4_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp KP_N9 &kp RA(N3)>;     // # = AltGr+3 en FR
        };
        
        rhr1c4_altgr_shift: rhr1c4_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sub_9 &sup_9>;
        };
        
        rhr1c4: rhr1c4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&rhr1c4_shift &rhr1c4_altgr_shift>;
        };
        
        /* =========
         * RH R1 C5 : 0 / @ / ₀ / ⁰
         * ========= */
        
        rhr1c5_shift: rhr1c5_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp KP_N0 &kp RA(N0)>;     // @ = AltGr+0 en FR
        };
        
        rhr1c5_altgr_shift: rhr1c5_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sub_0 &sup_0>;
        };
        
        rhr1c5: rhr1c5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&rhr1c5_shift &rhr1c5_altgr_shift>;
        };

        /* ========================================================= *
         * MOD-MORPHS pour LH et RH R2 (touches q-c-o-p-w-j-m-d-*-y) *
         * ========================================================= */

        /* =========
         * LH R2 C5 : q / Q / ^ / none
         * ========= */
        
        // NIVEAU 1 : Détecte AltGr
        lhr2c5_altgr: lhr2c5_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp A &lhr2c5_shift_altgr>;
        };
        
        // NIVEAU 2 : Avec AltGr (détecte Shift)
        lhr2c5_shift_altgr: lhr2c5_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RA(N9) &none>;    // AltGr = ^, Shift+AltGr = RIEN
        };

        /* =========
         * LH R2 C4 : c / C / < / ≤
         * ========= */

        lhr2c4_altgr_shift: lhr2c4_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp NON_US_BSLH &kp RA(NON_US_BSLH)>;
        };

        lhr2c4_altgr: lhr2c4_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp C &lhr2c4_altgr_shift>;
        };

        /* =========
         * LH R2 C3 : o / O / > / ≥
         * ========= */

        lhr2c3_altgr_shift: lhr2c3_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LS(NON_US_BSLH) &kp LS(RA(NON_US_BSLH))>;
        };

        lhr2c3_altgr: lhr2c3_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp O &lhr2c3_altgr_shift>;
        };

        /* =========
         * LH R2 C2 : p / P / $ / none
         * ========= */

        lhr2c2_altgr: lhr2c2_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp P &lhr2c2_shift_altgr>;
        };

        lhr2c2_shift_altgr: lhr2c2_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RBKT  &none>;    // AltGr = $, Shift+AltGr = RIEN
        };
    
        /* =========
         * LH R2 C1 : w / W / % / ‰
         * ========= */

        lhr2c1_altgr: lhr2c1_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp Z &lhr2c1_altgr_shift>;
        };

        lhr2c1_altgr_shift: lhr2c1_altgr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LS(SQT) &permille_compose>;
        };

        /* =========
         * RH R2 C1 : j / J / @ / rien
         * ========= */
        
        rhr2c1: rhr2c1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp J &rhr2c1_shift_altgr>;
        };
        
        rhr2c1_shift_altgr: rhr2c1_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RA(N0) &none>;       // @ = AltGr+0 en FR, Shift+AltGr = rien
        };
        
        /* =========
         * RH R2 C2 : m / M / & / rien
         * ========= */
        
        rhr2c2: rhr2c2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp SEMICOLON &rhr2c2_shift_altgr>;  // M en mapping inversé = SEMICOLON
        };
        
        rhr2c2_shift_altgr: rhr2c2_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp N1 &none>;           // & = N1 en FR, Shift+AltGr = rien
        };
        
        /* =========
         * RH R2 C3 : d / D / * / ×
         * ========= */
        
        rhr2c3: rhr2c3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp D &rhr2c3_shift_altgr>;
        };
        
        rhr2c3_shift_altgr: rhr2c3_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp BSLH &kp RA(COMMA)>;  // * = BSLH, × = AltGr+; (COMMA en FR)
        };
        
        /* =========
         * RH R2 C4 : layer_accented / ! / ' / rien
         * ========= */
        
        rhr2c4: rhr2c4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&rhr2c4_no_altgr &rhr2c4_shift_altgr>;
        };
        
        rhr2c4_no_altgr: rhr2c4_no_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&sl 5 &kp FSLH>;   // layer accents / ! (Shift+SLASH en FR)
        };
        
        rhr2c4_shift_altgr: rhr2c4_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp N4 &none>;              // ' = N4 en FR, Shift+AltGr = rien
        };
        
        /* =========
         * RH R2 C5 : y / Y / ` / rien
         * ========= */
        
        rhr2c5: rhr2c5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp Y &rhr2c5_shift_altgr>;
        };
        
        rhr2c5_shift_altgr: rhr2c5_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RA(N7) &none>;            // ` = AltGr+7 en FR, Shift+AltGr = rien
        };


        /* ========================================================= *
         * MOD-MORPHS pour LH et RH R3 (touches a-s-e-n-f-l-r-t-i-u  *
         * ========================================================= */

        /* ==========================================
         * MOD-MORPHS pour LH R3
         * ========================================== */
        
        /* =========
         * LH R3 C1 : f / F / = / ≠
         * ========= */
        
        lhr3c1: lhr3c1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp F &lhr3c1_shift_altgr>;
        };
        
        lhr3c1_shift_altgr: lhr3c1_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp EQUAL &kp LS(RA(MINUS))>;   // = / ≠
        };
        
        /* =========
         * LH R3 C2 : n / N / } / rien
         * ========= */
        
        lhr3c2: lhr3c2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp N &lhr3c2_shift_altgr>;
        };
        
        lhr3c2_shift_altgr: lhr3c2_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RA(EQUAL) &none>;           // } / rien
        };
        
        /* =========
         * LH R3 C3 : e / E / ) / rien
         * ========= */
        
        lhr3c3: lhr3c3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp E &lhr3c3_shift_altgr>;
        };
        
        lhr3c3_shift_altgr: lhr3c3_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp MINUS &none>;               // ) / rien
        };
        
        /* =========
         * LH R3 C4 : s / S / ( / rien
         * ========= */
        
        lhr3c4: lhr3c4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp S &lhr3c4_shift_altgr>;
        };
        
        lhr3c4_shift_altgr: lhr3c4_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp N5 &none>;                  // ( / rien
        };
        
        /* =========
         * LH R3 C5 : a / A / { / rien
         * ========= */
        
        lhr3c5: lhr3c5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp Q &lhr3c5_shift_altgr>;     // A en mapping inversé = Q
        };
        
        lhr3c5_shift_altgr: lhr3c5_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RA(N4) &none>;              // { / rien
        };
        
        /* ==========================================
         * MOD-MORPHS pour RH R3
         * ========================================== */
        
        /* =========
         * RH R3 C1 : l / L / \ / rien
         * ========= */
        
        rhr3c1: rhr3c1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp L &rhr3c1_shift_altgr>;
        };
        
        rhr3c1_shift_altgr: rhr3c1_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RA(N8) &none>;              // \ / rien
        };
        
        /* =========
         * RH R3 C2 : r / R / + / ±
         * ========= */
        
        rhr3c2: rhr3c2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp R &rhr3c2_shift_altgr>;
        };
        
        rhr3c2_shift_altgr: rhr3c2_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LS(EQUAL) &kp LS(RA(EQUAL))>;  // + / ±
        };
        
        /* =========
         * RH R3 C3 : t / T / - / rien
         * ========= */
        
        rhr3c3: rhr3c3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp T &rhr3c3_shift_altgr>;
        };
        
        rhr3c3_shift_altgr: rhr3c3_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp N6 &none>;                  // - / rien
        };
        
        /* =========
         * RH R3 C4 : i / I / / / ÷
         * ========= */
        
        rhr3c4: rhr3c4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp I &rhr3c4_shift_altgr>;
        };
        
        rhr3c4_shift_altgr: rhr3c4_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LS(DOT) &kp RA(DOT)>;       // / / ÷
        };
        
        /* =========
         * RH R3 C5 : u / U / " / rien
         * ========= */
        
        rhr3c5: rhr3c5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&kp U &rhr3c5_shift_altgr>;
