            bindings = <&kp RCTRL &kp RBKT &kp X>;
            label = "χ";
        };

        // Psi : ψ (Compose + * + q)

        psi: psi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp A>;  // Q en FR = A
            label = "ψ";
        };

        // Omega : ω (Compose + * + w)

        omega: omega {
            compatible = "zmk,behavior-macro";
