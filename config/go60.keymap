            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp FSLH &kp RA(N)>;           // ! / ¬
        };
        
        /* =========
         * RH R4 C3 : g / G / ; / rien
         * ========= */
        
        rhr4c3: rhr4c3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
