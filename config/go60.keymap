        };
        
        /* =========
         * LH R4 C3 : - / ? / ] / rien
         * ========= */
        
        lhr4c3: lhr4c3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
            bindings = <&lhr4c3_no_altgr &lhr4c3_shift_altgr>;
        };
        
        lhr4c3_no_altgr: lhr4c3_no_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp N6 &kp LS(M)>;             // - / ?
        };
        
        lhr4c3_shift_altgr: lhr4c3_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RA(MINUS) &none>;          // ] / rien
        };
        
        /* =========
         * LH R4 C4 : x / X / [ / rien
         * ========= */
        
        lhr4c4: lhr4c4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
