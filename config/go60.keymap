        };

        // Tréma : ḧ (¨ + h) - rare

        h_diae: h_diae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp H>;
            label = "ḧ";
            wait-ms = <0>;
        };

        // Ligature : œ (AltGr + o)

        oe_liga: oe_liga {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(O)>;
            label = "œ";
        };

        // Ligature : æ (AltGr + a)

        ae_liga: ae_liga {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(Q)>;
            label = "æ";
        };

        // Cédille : ç (touche 9 en FR)

        c_cedil: c_cedil {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_N9>;
            label = "ç";
        };

        // Caractère spécial : µ (micro/mu)

        mu: mu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(BSLH)>;
            label = "µ";
        };

        // … (ellipsis) U+2026
        // Ellipsis : … (Compose + . + .)

        ellipsis_compose: ellipsis_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings = <&kp RCTRL &kp KP_DOT &kp KP_DOT>;
            label = "…";
        };

        // ‑ (tiret insécable) U+2011
        // Tiret insécable : ‑ (Compose + - + , + -)

        nbsp_hyphen_compose: nbsp_hyphen_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp KP_MINUS &kp COMMA &kp KP_MINUS>;
            label = "‑";
        };

        // – (en dash) U+2013
        // En dash : – (Compose + - + -)

        en_dash_compose: en_dash_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings = <&kp RCTRL &kp KP_MINUS &kp KP_MINUS>;
            label = "–";
        };

        // — (em dash) U+2014
        // Em dash : — (Compose + - + - + -)

        em_dash_compose: em_dash_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings = <&kp RCTRL &kp KP_MINUS &kp KP_MINUS &kp KP_MINUS>;
            label = "—";
        };






        // · (middle dot) U+00B7
        // Middle dot : · (Compose + . + ^)

        middot_compose: middot_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp DOT &kp LBKT>;  // ^ = LBKT en FR
            label = "·";
        };

        // « (guillemet ouvrant) U+00AB
        // Guillemet ouvrant : « (Compose + < + <)

        guil_open_compose: guil_open_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings = <&kp RCTRL &kp LS(COMMA) &kp LS(COMMA)>;  // < = Shift+,
            label = "«";
        };

        // » (guillemet fermant) U+00BB
        // Guillemet fermant : » (Compose + > + >)

        guil_close_compose: guil_close_compose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings = <&kp RCTRL &kp LS(DOT) &kp LS(DOT)>;  // > = Shift+.
            label = "»";
        };



        // Alpha : α (Compose + * + a)

        alpha: alpha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp Q>;  // A en FR = Q
            label = "α";
        };

        // Beta : β (Compose + * + b)

        beta: beta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp B>;
            label = "β";
        };

        // Gamma : γ (Compose + * + g)

        gamma: gamma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp G>;
            label = "γ";
        };

        // Delta : δ (Compose + * + d)

        delta: delta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp D>;
            label = "δ";
        };

        // Epsilon : ε (Compose + * + e)

        epsilon: epsilon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp E>;
            label = "ε";
        };

        // Zeta : ζ (Compose + * + z)

        zeta: zeta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp Z>;  // Z en FR = W, mais pour zeta c'est la lettre latine z qui correspond
            label = "ζ";
        };

        // Eta : η (Compose + * + y)

        eta: eta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp Y>;
            label = "η";
        };

        // Theta : θ (Compose + * + h)

        theta: theta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp H>;
            label = "θ";
        };

        // Iota : ι (Compose + * + i)

        iota: iota {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp I>;
            label = "ι";
        };

        // Kappa : κ (Compose + * + k)

        kappa: kappa {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp K>;
            label = "κ";
        };

        // Lambda : λ (Compose + * + l)

        lambda: lambda {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp L>;
            label = "λ";
        };

        // Mu : μ (Compose + m + u)

        mu_greek: mu_greek {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp SEMICOLON>;  // M en FR = SEMICOLON (touche M physique)
            label = "μ";
        };

        // Nu : ν (Compose + * + n)

        nu: nu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp N>;
            label = "ν";
        };

        // Xi : ξ (Compose + * + j)

        xi: xi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp J>;
            label = "ξ";
        };

        // Omicron : ο (Compose + * + o)

        omicron: omicron {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp O>;
            label = "ο";
        };

        // Pi : π (Compose + * + p)

        pi: pi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp P>;
            label = "π";
        };

        // Rho : ρ (Compose + * + r)

        rho: rho {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp R>;
            label = "ρ";
        };

        // Sigma : σ (Compose + * + s)

        sigma: sigma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp S>;
            label = "σ";
        };

        // Tau : τ (Compose + * + t)

        tau: tau {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp T>;
            label = "τ";
        };

        // Upsilon : υ (Compose + * + u)

        upsilon: upsilon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RBKT &kp U>;
            label = "υ";
        };

        // Phi : φ (Compose + * + f)

        phi: phi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
